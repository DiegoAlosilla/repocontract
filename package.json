{
  "name": "repocontract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visualiza OpenAPI y Swagger dentro de GitHub, sin salir del archivo.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:live": "node scripts/live-smoke.mjs",
    "check": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "swagger-ui-dist": "5.33.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  },
  "scarfSettings": { "enabled": false },
  "engines": { "node": ">=22" }
}
